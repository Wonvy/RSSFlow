{
  "name": "rssflow",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run build -w @rssflow/extension && npm run dev -w @rssflow/server",
    "start": "npm start -w @rssflow/server",
    "build:ext": "npm run build -w @rssflow/extension",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
